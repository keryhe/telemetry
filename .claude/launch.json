{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "telemetry-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 4201,
      "cwd": "src/telemetry-client"
    },
    {
      "name": "telemetry-collector",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Keryhe.Telemetry.Collector.Server"],
      "port": 5117
    },
    {
      "name": "telemetry-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Keryhe.Telemetry.Api.Server"],
      "port": 5188
    }
  ]
}
