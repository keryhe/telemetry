<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.15.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="ClickHouse.Client" Version="7.14.0" />
  </ItemGroup>

  <!-- The real schema/*.sql scripts, copied next to the consuming project's binaries under Schema/.
       Content items flow through a ProjectReference, so the integration tests and the stress harness
       both find them at AppContext.BaseDirectory/Schema/. -->
  <ItemGroup>
    <Content Include="../../schema/PostgreSQL-ControlPlane.sql" Link="Schema/PostgreSQL-ControlPlane.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../schema/PostgreSQL-Telemetry.sql" Link="Schema/PostgreSQL-Telemetry.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../schema/SqlServer-ControlPlane.sql" Link="Schema/SqlServer-ControlPlane.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../schema/SqlServer-Telemetry.sql" Link="Schema/SqlServer-Telemetry.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../schema/MySQL-ControlPlane.sql" Link="Schema/MySQL-ControlPlane.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../schema/MySQL-Telemetry.sql" Link="Schema/MySQL-Telemetry.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../schema/ClickHouse-Telemetry.sql" Link="Schema/ClickHouse-Telemetry.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
