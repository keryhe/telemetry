<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c909d5eb-6fbc-4ee8-8c0a-d4e762606018</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pin to override the vulnerable Microsoft.OpenApi 2.0.0 pulled transitively (GHSA-v5pm-xwqc-g5wc) -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keryhe.Telemetry.Api\Keryhe.Telemetry.Api.csproj" />
    <ProjectReference Include="..\Keryhe.Telemetry.Collector\Keryhe.Telemetry.Collector.csproj" />
    <!-- All providers are referenced; the active one is chosen at runtime via Database:Provider. -->
    <ProjectReference Include="..\Keryhe.Telemetry.SqlServer\Keryhe.Telemetry.SqlServer.csproj" />
    <ProjectReference Include="..\Keryhe.Telemetry.PostgreSQL\Keryhe.Telemetry.PostgreSQL.csproj" />
    <ProjectReference Include="..\Keryhe.Telemetry.Timescale\Keryhe.Telemetry.Timescale.csproj" />
    <ProjectReference Include="..\Keryhe.Telemetry.ClickHouse\Keryhe.Telemetry.ClickHouse.csproj" />
    <ProjectReference Include="..\Keryhe.Telemetry.MySql\Keryhe.Telemetry.MySql.csproj" />
  </ItemGroup>

  <!-- ── ANGULAR CLIENT ──────────────────────────────────────────────────────
       On publish, build src/telemetry-client and stage its output into the
       published wwwroot so this host serves the UI alongside /api. Nothing is
       written into the source tree, and a plain `dotnet build` never runs npm.
       Set -p:BuildSpaOnPublish=false to publish against an already-built dist
       (e.g. a CI stage that builds the UI separately).                        -->
  <PropertyGroup>
    <SpaRoot>..\telemetry-client\</SpaRoot>
    <SpaDist>$(SpaRoot)dist\telemetry-client\browser\</SpaDist>
    <BuildSpaOnPublish Condition="'$(BuildSpaOnPublish)' == ''">true</BuildSpaOnPublish>
  </PropertyGroup>

  <Target Name="BuildAngularClient"
          BeforeTargets="PrepareForPublish"
          Condition="'$(BuildSpaOnPublish)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!-- Runs after BuildAngularClient: the item group is only correct once dist exists. -->
  <Target Name="IncludeAngularClient"
          AfterTargets="BuildAngularClient"
          BeforeTargets="PrepareForPublish">
    <ItemGroup>
      <_SpaFiles Include="$(SpaDist)**\*" />
      <ResolvedFileToPublish Include="@(_SpaFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
