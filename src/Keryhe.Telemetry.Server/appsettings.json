{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:5117",
        "Protocols": "Http2"
      },
      "GrpcTls": {
        "Url": "https://0.0.0.0:7057",
        "Protocols": "Http2"
      },
      "Api": {
        "Url": "http://0.0.0.0:5188",
        "Protocols": "Http1"
      },
      "ApiTls": {
        "Url": "https://0.0.0.0:7105",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Database": {
    "Provider": "Timescale"
  },
  "ConnectionStrings": {
    "Read": "",
    "Write": ""
  },
  "AlertEvaluation": {
    "IntervalSeconds": 60,
    "Enabled": true
  },
  "Telemetry": {
    "Ingestion": {
      "MaxQueuedLogRecords": 200000,
      "MaxQueuedMetrics": 200000,
      "MaxQueuedSpans": 200000,
      "MaxLogFlushBatchSize": 2000,
      "MaxMetricFlushBatchSize": 2000,
      "MaxTraceFlushSpanBatchSize": 2000,
      "FlushConcurrency": 4,
      "MaxFlushRetries": 5,
      "RetryBaseDelayMilliseconds": 200,
      "RetryMaxDelayMilliseconds": 5000
    },
    "TenantResolution": {
      "PositiveCacheTtlSeconds": 30,
      "NegativeCacheTtlSeconds": 5,
      "LastUsedFlushIntervalSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "https://localhost:4201"
    ]
  }
}
