<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ca957620-f71d-4561-8dec-c71d4bf490d9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pin to override the vulnerable Microsoft.OpenApi 2.0.0 pulled transitively (GHSA-v5pm-xwqc-g5wc) -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keryhe.Telemetry.Api\Keryhe.Telemetry.Api.csproj" />
    <!-- Prebuilt Angular UI, packaged as static web assets — see Keryhe.Telemetry.Ui's own
         csproj for how src/telemetry-client gets built and staged into it. Referencing it here
         (rather than the former per-host BuildAngularClient/IncludeAngularClient targets) is what
         makes the UI available to `dotnet run` too, not just a publish — see Program.cs. -->
    <ProjectReference Include="..\Keryhe.Telemetry.Ui\Keryhe.Telemetry.Ui.csproj" />
  </ItemGroup>

</Project>
