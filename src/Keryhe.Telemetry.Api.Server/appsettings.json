{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Api": "",
    "ControlPlane": ""
  },
  "Telemetry": {
    "Parquet": {
      "RootPath": ""
    },
    "Api": {
      "Provider": {
        "Database": "Parquet",
        "ControlPlane": "Sqlite"
      },
      "BasePath": "/telemetry/api",
      "FixedTenantId": 1
    },
    "Query": {
      "SummaryTimeoutSeconds": 10
    },
    "AlertEvaluation": {
      "IntervalSeconds": 60,
      "Enabled": true
    },
    "Retention": {
      "IntervalSeconds": 3600,
      "Enabled": true
    }
  },
  "TelemetryUi": {
    "BasePath": "/telemetry",
    "BrandName": "Sentinel",
    "BrandTagline": "OpenTelemetry Visualization"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "https://localhost:4201"
    ]
  }
}
