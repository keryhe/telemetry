{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Timescale"
  },
  "ConnectionStrings": {
    "Read": ""
  },
  "AlertEvaluation": {
    "IntervalSeconds": 60,
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "https://localhost:4201"
    ]
  }
}
