{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL"
  },
  "ConnectionStrings": {
    "Api": ""
  },
  "Telemetry": {
    "Api": {
      "BasePath": "/telemetry/api"
    },
    "Query": {
      "SummaryTimeoutSeconds": 10
    },
    "AlertEvaluation": {
      "IntervalSeconds": 60,
      "Enabled": true
    },
    "Retention": {
      "IntervalSeconds": 3600,
      "Enabled": true
    }
  },
  "TelemetryUi": {
    "BasePath": "/telemetry",
    "BrandName": "Sentinel",
    "BrandTagline": "OpenTelemetry Visualization"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "https://localhost:4201"
    ]
  }
}
