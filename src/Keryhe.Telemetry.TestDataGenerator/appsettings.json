{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Generator": {
    "OtlpEndpoint": "https://localhost:7057",
    "Seed": 42,
    "PeakRequestsPerSecond": 2,
    "Environment": "production",
    "PodsPerService": 2,
    "LiveMetricIntervalSeconds": 15,
    "LiveLagSeconds": 10,
    "Live": true,
    "Backfill": {
      "Enabled": false,
      "Window": "1.00:00:00",
      "ChunkSeconds": 60,
      "MaxSpansPerExport": 2000
    },
    "Tenants": [
      { "Name": "acme-retail", "Scale": 1.0 },
      { "Name": "contoso-dev", "Scale": 0.3 },
      { "Name": "globex-payments", "Scale": 3.0 }
    ],
    "Incidents": [
      {
        "Name": "Payment provider degradation",
        "Tenant": "acme-retail", "Service": "payment-service",
        "At": "14:00:00", "Duration": "00:20:00", "LatencyMultiplier": 6, "ExtraErrorRate": 0.25
      },
      {
        "Name": "Gateway error spike",
        "Tenant": "acme-retail", "Service": "api-gateway",
        "At": "02:15:00", "Duration": "00:06:00", "LatencyMultiplier": 1.5, "ExtraErrorRate": 0.4
      },
      {
        "Name": "Bad catalog deploy, then rollback",
        "Tenant": "contoso-dev", "Service": "catalog-service",
        "At": "10:30:00", "Duration": "00:25:00", "LatencyMultiplier": 2.5, "ExtraErrorRate": 0.3, "Version": "2.8.0-rc1"
      },
      {
        "Name": "Inventory database slowdown",
        "Tenant": "globex-payments", "Service": "inventory-service",
        "At": "18:00:00", "Duration": "00:40:00", "LatencyMultiplier": 4, "ExtraErrorRate": 0.08
      }
    ]
  }
}
