@using Keryhe.Telemetry.Client.Components.Shared
@inherits LayoutComponentBase
@inject Keryhe.Telemetry.Client.Services.LocalStorageService LocalStorage
@inject Keryhe.Telemetry.Client.Services.State.TimeRangeState TimeRangeState

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="mr-4" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <SectionOutlet SectionName="page-title" />
        <MudSpacer />
        <TimeRangePicker />
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" OnClick="@ToggleSettings" />
    </MudAppBar>
    <MudDrawer @bind-Open="_open" ClipMode="DrawerClipMode.Never" Elevation="2" Width="150px">
        <MudDrawerHeader>
            <MudStack Spacing="0" Justify="Justify.Center">
                <MudText Style="font-family: Georgia, 'Times New Roman', serif; font-size: 1.35rem; font-weight: 600; line-height: 1.2; letter-spacing: 0.01em;">Lantern</MudText>
                <MudText Style="font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; font-size: 0.7rem; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.7;">Observability</MudText>
            </MudStack>
        </MudDrawerHeader>
        <MudDrawerContainer>
            <MudNavMenu>
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
                <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.List" Match="NavLinkMatch.All">Logs</MudNavLink>
                <MudNavLink Href="/traces" Icon="@Icons.Material.Filled.Lan" Match="NavLinkMatch.All">Traces</MudNavLink>
                <MudNavLink Href="/metrics" Icon="@Icons.Material.Filled.BarChart" Match="NavLinkMatch.All">Metrics</MudNavLink>
                <MudNavLink Href="/alerts" Icon="@Icons.Material.Filled.NotificationsActive" Match="NavLinkMatch.All">Alerts</MudNavLink>
            </MudNavMenu>
        </MudDrawerContainer>
    </MudDrawer>
    <MudDrawer @bind-Open="_settings" Anchor="Anchor.End" Elevation="1" Variant="DrawerVariant.Temporary">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Settings</MudText>
        </MudDrawerHeader>
        <MudDrawerContainer>
            <MudSwitch Value="_isDarkMode" ValueChanged="OnDarkModeChanged" Color="Color.Primary" Class="ma-4" T="bool" Label="@(_isDarkMode ? "Light Mode" : "Dark Mode")"/>
        </MudDrawerContainer>
    </MudDrawer>
    <MudMainContent Class="pt-20 px-5">
        @Body
    </MudMainContent>
</MudLayout>

@code{
    private bool _open = true;
    private bool _settings = false;
    private bool _isDarkMode;
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Indigo.Default,
            PrimaryContrastText = "#FFFFFF",
            Secondary = Colors.Pink.Default,
            SecondaryContrastText = "#FFFFFF",
            Success = "#22C55E",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#EEF2FF",
            AppbarText = "#1E1B4B",
            DrawerBackground = "#F1F5F9",
            DrawerText = "#000000",
            DrawerIcon = "#6366F1",
            TextPrimary = "#0F172A",
            TextSecondary = "#475569",
            ActionDefault = "#64748B",
            LinesDefault = "#E2E8F0",
            TableLines = "#E2E8F0",
            Divider = "#E2E8F0",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Indigo.Lighten1,
            PrimaryContrastText = "#0F172A",
            Secondary = Colors.Pink.Lighten2,
            SecondaryContrastText = "#0F172A",
            Success = "#4ADE80",
            Warning = "#FBBF24",
            Error = "#F87171",
            Background = "#0D1117",
            Surface = "#161B22",
            AppbarBackground = "#161B22",
            AppbarText = "#E2E8F0",
            DrawerBackground = "#060A0F",
            DrawerText = "#E2E8F0",
            DrawerIcon = "#A78BFA",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            ActionDefault = "#94A3B8",
            LinesDefault = "#334155",
            TableLines = "#334155",
            Divider = "#334155",
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _isDarkMode = await LocalStorage.GetItemAsync<bool>("ui.isDarkMode");
        await TimeRangeState.LoadAsync();
        StateHasChanged();
    }

    private async Task OnDarkModeChanged(bool value)
    {
        _isDarkMode = value;
        await LocalStorage.SetItemAsync("ui.isDarkMode", value);
    }

    private void ToggleDrawer()
    {
        _open = !_open;
        Console.WriteLine($"Drawer toggled! New state: {_open}");
    }

    private void ToggleSettings()
    {
        _settings = true;
    }
}