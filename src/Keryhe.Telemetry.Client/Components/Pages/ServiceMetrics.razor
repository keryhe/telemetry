@page "/service-metrics"
@using Keryhe.Telemetry.Core.Models
@using Keryhe.Telemetry.Client.Components.Shared
@using Keryhe.Telemetry.Client.Models

<PageTitle>Service Metrics Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Service Metrics Dashboard</MudText>

    <!-- Service Selector -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudSelect @bind-Value="_selectedService"
                       Label="Select Service"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       T="string"
                       Style="min-width: 300px;">
                @foreach (var service in _availableServices)
                {
                    <MudSelectItem Value="@service">@service</MudSelectItem>
                }
            </MudSelect>

            <MudSwitch @bind-Value="_autoRefresh"
                       Color="Color.Primary"
                       Label="Auto-refresh"
                       T="bool"/>

            @if (_autoRefresh)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    (every 30s)
                </MudText>
            }

            @if (_loading)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true"/>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Loading @_loadedCount of @_totalCount metrics...
                    </MudText>
                </MudStack>
            }

            <MudSpacer/>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="RefreshDataAsync"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(string.IsNullOrEmpty(_selectedService) || _loading)">
                Refresh
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (string.IsNullOrEmpty(_selectedService))
    {
        <MudPaper Class="pa-4 d-flex align-center justify-center" Style="height: 300px;">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Color="Color.Secondary"/>
                <MudText Typo="Typo.h6" Color="Color.Secondary">Select a service to view metrics</MudText>
            </MudStack>
        </MudPaper>
    }
    else if (_loading && !_metrics.Any())
    {
        <MudPaper Class="pa-4 d-flex align-center justify-center" Style="height: 300px;">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                <MudText Typo="Typo.h6">Loading metrics...</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_loadedCount of @_totalCount loaded
                </MudText>
            </MudStack>
        </MudPaper>
    }
    else if (!_metrics.Any())
    {
        <MudAlert Severity="Severity.Info">
            No metrics found for service "@_selectedService"
        </MudAlert>
    }
    else
    {
        <!-- Summary Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Total Metrics</MudText>
                            <MudText Typo="Typo.h4">@_metrics.Count</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Gauges</MudText>
                            <MudText Typo="Typo.h4">@_gaugeMetrics.Count</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Counters</MudText>
                            <MudText Typo="Typo.h4">@_counterMetrics.Count</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Other</MudText>
                            <MudText Typo="Typo.h4">@_otherMetrics.Count</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Gauges Section -->
        @if (_gaugeMetrics.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3">Gauges</MudText>
            <MudGrid Class="mb-4">
                @foreach (var metric in _gaugeMetrics)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MetricCard MetricName="@metric.MetricName"
                                    Unit="@metric.Unit"
                                    MetricType="@metric.Type"
                                    CurrentValue="@metric.CurrentValue"
                                    MinValue="@metric.MinValue"
                                    MaxValue="@metric.MaxValue"
                                    AvgValue="@metric.AvgValue"
                                    PreviousValue="@metric.PreviousValue"
                                    DataPoints="@metric.DataPoints"
                                    ShowStats="true"/>
                    </MudItem>
                }
            </MudGrid>
        }

        <!-- Counters Section -->
        @if (_counterMetrics.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3">Counters</MudText>
            <MudGrid Class="mb-4">
                @foreach (var metric in _counterMetrics)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MetricCard MetricName="@metric.MetricName"
                                    Unit="@metric.Unit"
                                    MetricType="@metric.Type"
                                    CurrentValue="@metric.CurrentValue"
                                    MinValue="@metric.MinValue"
                                    MaxValue="@metric.MaxValue"
                                    AvgValue="@metric.AvgValue"
                                    PreviousValue="@metric.PreviousValue"
                                    DataPoints="@metric.DataPoints"
                                    ShowStats="true"/>
                    </MudItem>
                }
            </MudGrid>
        }

        <!-- Other Metrics Section -->
        @if (_otherMetrics.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3">Histograms & Summary</MudText>
            <MudGrid Class="mb-4">
                @foreach (var metric in _otherMetrics)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MetricCard MetricName="@metric.MetricName"
                                    Unit="@metric.Unit"
                                    MetricType="@metric.Type"
                                    CurrentValue="@metric.CurrentValue"
                                    MinValue="@metric.MinValue"
                                    MaxValue="@metric.MaxValue"
                                    AvgValue="@metric.AvgValue"
                                    PreviousValue="@metric.PreviousValue"
                                    DataPoints="@metric.DataPoints"
                                    ShowStats="false"/>
                    </MudItem>
                }
            </MudGrid>
        }
    }
</MudContainer>

