@page "/alerts"
@using Keryhe.Telemetry.Core.Models
@using Keryhe.Telemetry.Alerting.Models
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<!-- Header -->
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h6">Alert Rules</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        New Rule
    </MudButton>
</MudStack>

<!-- Rules Table -->
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-2" />
}

<MudTable Items="_rules" Hover="true" Dense="true" Elevation="1" Class="mb-6">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Service</MudTh>
        <MudTh>Condition</MudTh>
        <MudTh>Cooldown</MudTh>
        <MudTh>Last Fired</MudTh>
        <MudTh>Enabled</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name"><MudText Typo="Typo.body2"><b>@context.Name</b></MudText></MudTd>
        <MudTd DataLabel="Type">
            <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Type)" Text="@context.Type.ToString()" />
        </MudTd>
        <MudTd DataLabel="Service">@(context.ServiceName ?? "All services")</MudTd>
        <MudTd DataLabel="Condition"><MudText Typo="Typo.caption">@FormatCondition(context)</MudText></MudTd>
        <MudTd DataLabel="Cooldown">@context.CooldownMinutes min</MudTd>
        <MudTd DataLabel="Last Fired">@(context.LastFiredAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never")</MudTd>
        <MudTd DataLabel="Enabled">
            <MudSwitch T="bool"
                       Value="@context.Enabled"
                       ValueChanged="@((val) => _ = ToggleRuleAsync(context, val))"
                       Color="Color.Success" />
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           OnClick="@(() => OpenEditDialog(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(() => _ = DeleteRuleAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4" Align="Align.Center" Color="Color.Secondary">No alert rules configured. Click "New Rule" to get started.</MudText>
    </NoRecordsContent>
</MudTable>

<!-- Alert Event History -->
<MudText Typo="Typo.h6" Class="mb-2">Recent Firings</MudText>
<MudTable Items="_events" Hover="true" Dense="true" Elevation="1">
    <HeaderContent>
        <MudTh>Rule</MudTh>
        <MudTh>Fired At</MudTh>
        <MudTh>Details</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Rule">@(context.Rule?.Name ?? $"Rule #{context.RuleId}")</MudTd>
        <MudTd DataLabel="Fired At">@context.FiredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
        <MudTd DataLabel="Details"><MudText Typo="Typo.caption">@ParseDetails(context.DetailsJson)</MudText></MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4" Align="Align.Center" Color="Color.Secondary">No alerts have fired yet.</MudText>
    </NoRecordsContent>
</MudTable>

<!-- Create / Edit Dialog -->
<MudDialog @bind-Visible="_showDialog"
           Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEditing ? "Edit Alert Rule" : "New Alert Rule")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Name"
                          Label="Rule Name"
                          Variant="Variant.Outlined"
                          Required="true" />

            <MudSelect @bind-Value="_form.Type"
                       Label="Alert Type"
                       Variant="Variant.Outlined"
                       T="AlertRuleType">
                @foreach (AlertRuleType t in Enum.GetValues(typeof(AlertRuleType)))
                {
                    <MudSelectItem Value="@t">@t</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_form.ServiceName"
                          Label="Service Name (leave blank for all services)"
                          Variant="Variant.Outlined" />

            <!-- Condition fields — dynamic based on type -->
            @if (_form.Type == AlertRuleType.MetricThreshold)
            {
                <MudTextField @bind-Value="_form.MetricName"
                              Label="Metric Name"
                              Variant="Variant.Outlined"
                              Required="true" />
                <MudStack Row="true" Spacing="2">
                    <MudSelect @bind-Value="_form.Operator"
                               Label="Operator"
                               Variant="Variant.Outlined"
                               Style="min-width: 120px;"
                               T="string">
                        <MudSelectItem Value=@(">")>&gt;</MudSelectItem>
                        <MudSelectItem Value=@("<")>&lt;</MudSelectItem>
                        <MudSelectItem Value=@(">=")>&gt;=</MudSelectItem>
                        <MudSelectItem Value=@("<=")>&lt;=</MudSelectItem>
                    </MudSelect>
                    <MudNumericField @bind-Value="_form.Threshold"
                                     Label="Threshold"
                                     Variant="Variant.Outlined"
                                     T="double" />
                </MudStack>
            }
            else if (_form.Type == AlertRuleType.ErrorRate)
            {
                <MudStack Row="true" Spacing="2">
                    <MudNumericField @bind-Value="_form.ThresholdPercent"
                                     Label="Error Rate Threshold (%)"
                                     Variant="Variant.Outlined"
                                     Min="0.1" Max="100.0"
                                     T="double" />
                    <MudNumericField @bind-Value="_form.WindowMinutes"
                                     Label="Window (minutes)"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     T="int" />
                </MudStack>
            }
            else if (_form.Type == AlertRuleType.SlowTrace)
            {
                <MudStack Row="true" Spacing="2">
                    <MudNumericField @bind-Value="_form.MinDurationMs"
                                     Label="Min Duration (ms)"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     T="int" />
                    <MudNumericField @bind-Value="_form.WindowMinutes"
                                     Label="Window (minutes)"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     T="int" />
                </MudStack>
            }
            else if (_form.Type == AlertRuleType.LogSeveritySpike)
            {
                <MudStack Row="true" Spacing="2">
                    <MudSelect @bind-Value="_form.MinSeverity"
                               Label="Min Severity"
                               Variant="Variant.Outlined"
                               T="int">
                        <MudSelectItem Value="5">Debug (5)</MudSelectItem>
                        <MudSelectItem Value="9">Info (9)</MudSelectItem>
                        <MudSelectItem Value="13">Warning (13)</MudSelectItem>
                        <MudSelectItem Value="17">Error (17)</MudSelectItem>
                        <MudSelectItem Value="21">Fatal (21)</MudSelectItem>
                    </MudSelect>
                    <MudNumericField @bind-Value="_form.CountThreshold"
                                     Label="Count Threshold"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     T="int" />
                    <MudNumericField @bind-Value="_form.WindowMinutes"
                                     Label="Window (minutes)"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     T="int" />
                </MudStack>
            }

            <MudTextField @bind-Value="_form.WebhookUrl"
                          Label="Webhook URL"
                          Variant="Variant.Outlined"
                          Required="true"
                          HelperText="POST target — use webhook.site to test, or point at Slack/PagerDuty/n8n." />

            <MudNumericField @bind-Value="_form.CooldownMinutes"
                             Label="Cooldown (minutes)"
                             Variant="Variant.Outlined"
                             Min="1"
                             HelperText="Minimum time between notifications for this rule."
                             T="int" />

            <MudSwitch @bind-Value="_form.Enabled"
                       Color="Color.Success"
                       Label="Enabled" />

            @if (!string.IsNullOrEmpty(_dialogError))
            {
                <MudAlert Severity="Severity.Error">@_dialogError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDialog = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveRuleAsync"
                   Disabled="_saving">
            @(_saving ? "Saving…" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>
