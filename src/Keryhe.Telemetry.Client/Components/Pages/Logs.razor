@page "/logs"
@using Keryhe.Telemetry.Core.Models

<MudStack StretchItems="@StretchItems.Start" Row>
    <MudTextField @bind-Value="_searchText"
                  Placeholder="Search logs..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"/>
    <div>
        <MudDateRangePicker @bind-DateRange="_dateRange" Clearable="true"
                            Variant="Variant.Outlined"
                            PickerVariant="PickerVariant.Dialog"
                            Margin="Margin.Dense"
                            PlaceholderStart="Start Date"
                            PlaceholderEnd="End Date"/>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="SearchLogs"
               StartIcon="@Icons.Material.Filled.Search">
        Search
    </MudButton>
</MudStack>
<MudChart ChartType="ChartType.StackedBar"
          ChartSeries="@_chartSeries"
          XAxisLabels="@_chartXAxisLabels"
          Width="100%"
          Height="150px"
          LegendPosition="Position.Right" 
          AxisChartOptions="new AxisChartOptions { MatchBoundsToSize = true }"
          ChartOptions="@_chartOptions">
</MudChart>
<MudDataGrid T="LogRecordModel"
             Items="@_logs"
             Loading="@_dataLoading"
             Height="calc(100vh - 24rem);"
             FixedHeader="true"
             Virtualize="true"
             Dense="true"
             ColumnResizeMode="ResizeMode.Container">
    <Columns>
        <HierarchyColumn T="LogRecordModel" HeaderClass="mud-theme-secondary" />
        <TemplateColumn Title="Timestamp" HeaderClass="mud-theme-secondary">
            <CellTemplate>
                @if (context.Item.TimeUnixNano.HasValue)
                {
                    @FormatUnixNanoToDateTime(context.Item.TimeUnixNano.Value)
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Level" HeaderClass="mud-theme-secondary">
            <CellTemplate>
                <MudChip Size="Size.Small" Style="@($"background-color: {GetSeverityColor(context.Item.SeverityText)}; color: {Colors.Shades.White}")" Variant="Variant.Text">
                    @context.Item.SeverityText
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.BodyValue" Title="Message" Sortable="false" HeaderClass="mud-theme-secondary"/>
    </Columns>
    <ChildRowContent>
        <MudCard>
            <MudCardHeader Style="@($"background-color: {Colors.BlueGray.Lighten5};")" >
                <MudGrid>
                    <MudItem>
                        <MudText Typo="Typo.body2">Trace Id:</MudText>
                        <MudText Typo="Typo.body2">Span Id</MudText>
                        <MudText Typo="Typo.body2">Scope:</MudText>
                    </MudItem>
                    <MudItem>
                        <MudText Typo="Typo.body2">@context.Item.TraceIdHex</MudText>
                        <MudText Typo="Typo.body2">@context.Item.SpanIdHex</MudText>
                        <MudText Typo="Typo.body2">@context.Item.InstrumentationScope?.Name</MudText>
                    </MudItem>
                </MudGrid>
            </MudCardHeader>
            <MudCardContent>
                <MudDataGrid Items="@GetDetails(context.Item)" TItem="object" HeaderClass="mud-theme-tertiary">
                    <Columns>
                        <PropertyColumn Property="x => x.Key" Title="Key" HeaderClass="mud-theme-tertiary" />
                        <PropertyColumn Property="x => x.Value" Title="Value" HeaderClass="mud-theme-tertiary"/>
                    </Columns>
                </MudDataGrid>
            </MudCardContent>
        </MudCard>
    </ChildRowContent>
    <PagerContent>
        <MudDataGridPager T="LogRecordModel"
                          PageSizeOptions="new int[] { 10, 25, 50, 100 }"/>
    </PagerContent>
</MudDataGrid>
