@page "/logs"
@using Keryhe.Telemetry.Core.Models

<!-- Row 1: Dropdowns, Date Range, and Search Button -->
<MudStack Spacing="2" Class="mb-2">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect @bind-Value="_selectedService"
                   Label="Service"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   Style="min-width: 250px;"
                   T="string">
            @foreach (var service in _availableServices)
            {
                <MudSelectItem Value="@service">@service</MudSelectItem>
            }
        </MudSelect>
        
        <MudSelect @bind-Value="_selectedSeverity"
                   Label="Log Level"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   Style="min-width: 200px;"
                   T="string">
            @foreach (var severity in _severityLevels)
            {
                <MudSelectItem Value="@severity">
                    <MudChip T="string"
                             Size="Size.Small"
                             Style="@($"background-color: {GetSeverityColor(severity)}; color: white;")"
                             Text="@severity" />
                </MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SearchLogs"
                   StartIcon="@Icons.Material.Filled.Search">
            Search
        </MudButton>
    </MudStack>
    
    <!-- Row 2: Text Search Field -->
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_searchText"
                      Placeholder='Search: Trace ID OR "error text" OR key=value OR key:value'
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      HelperText="Examples: abc123def456... (Trace ID) | 'database error' | http.status_code=500"
                      Style="flex: 1;"/>
        @if (IsTraceIdSearch)
        {
            <MudChip T="string"
                     Size="Size.Small" 
                     Color="Color.Info" 
                     Icon="@Icons.Material.Filled.Link"
                     Text="Trace ID Search"
                     Style="margin-bottom: 20px;"/>
        }
        <MudIconButton Icon="@Icons.Material.Filled.HelpOutline"
                       Color="Color.Info"
                       Size="Size.Small"
                       OnClick="@(() => _showSearchHelp = true)"
                       Style="margin-top: 4px;"/>
    </MudStack>
</MudStack>

<!-- Search Help Dialog -->
<MudDialog @bind-Visible="_showSearchHelp" Options="new DialogOptions { MaxWidth = MaxWidth.Medium }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Help" Class="mr-2"/> Search Syntax Guide
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-2">Search Types</MudText>
        <MudSimpleTable Dense="true" Style="margin-bottom: 16px;">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Example</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Trace ID</strong></td>
                    <td><code>abc123def456...</code></td>
                    <td>Search by trace ID (32 hex chars, date range not required)</td>
                </tr>
                <tr>
                    <td><strong>Free Text</strong></td>
                    <td><code>"database error"</code></td>
                    <td>Searches in log message body</td>
                </tr>
                <tr>
                    <td><strong>Exact Match</strong></td>
                    <td><code>http.status_code=500</code></td>
                    <td>Exact attribute value match</td>
                </tr>
                <tr>
                    <td><strong>Contains</strong></td>
                    <td><code>url:'/api/users'</code></td>
                    <td>Attribute value contains text</td>
                </tr>
                <tr>
                    <td><strong>Multiple (AND)</strong></td>
                    <td><code>"error" AND status_code=500</code></td>
                    <td>All conditions must match</td>
                </tr>
            </tbody>
        </MudSimpleTable>
        
        <MudText Typo="Typo.subtitle2" Class="mb-2">Examples</MudText>
        <div style="padding-left: 16px;">
            <MudStack Spacing="2">
                <MudStack Row="true" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Primary"/>
                    <code>a1b2c3d4e5f6...</code> - Find all logs for a specific trace ID
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Primary"/>
                    <code>database timeout</code> - Find logs with "database timeout" in message
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Primary"/>
                    <code>http.status_code=500</code> - Find logs with status code exactly 500
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Primary"/>
                    <code>thread.id:5</code> - Find logs where thread.id contains "5"
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Primary"/>
                    <code>"connection failed" AND service.name=api-gateway</code> - Combine conditions
                </MudStack>
            </MudStack>
        </div>
        
        <MudAlert Severity="Severity.Info" Class="mt-3">
            <strong>Tip:</strong> Attribute searches look in Log Attributes, Resource Attributes, and Scope Attributes.
        </MudAlert>
        
        <MudAlert Severity="Severity.Success" Class="mt-2">
            <strong>Trace ID Search:</strong> When searching by trace ID (exactly 32 hex characters), 
            the date range is optional and will be ignored. This allows you to find logs across any time period.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showSearchHelp = false)">Got it!</MudButton>
    </DialogActions>
</MudDialog>

<div @ref="_chartContainer" style="position: relative; user-select: none;">
    <MudChart ChartType="ChartType.StackedBar"
              ChartSeries="@_chartSeries"
              XAxisLabels="@_chartXAxisLabels"
              Width="100%"
              Height="150px"
              LegendPosition="Position.Right"
              AxisChartOptions="new AxisChartOptions { MatchBoundsToSize = true }"
              ChartOptions="@_chartOptions">
    </MudChart>

    <!-- Pointer-capture overlay for click and drag-to-select -->
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;
                cursor: crosshair; z-index: 10;"
         @onpointerdown="OnOverlayPointerDown"
         @onpointerdown:preventDefault="true"
         @onpointermove="OnOverlayPointerMove"
         @onpointerup="OnOverlayPointerUp"
         @onpointercancel="OnOverlayPointerCancel">

        @if (_isDragging && _highlightWidth > 2)
        {
            <div style="position: absolute; top: 0; bottom: 0;
                        left: @(_highlightLeft.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))px;
                        width: @(_highlightWidth.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))px;
                        background-color: rgba(25, 118, 210, 0.25);
                        border-left: 2px solid rgba(25, 118, 210, 0.7);
                        border-right: 2px solid rgba(25, 118, 210, 0.7);
                        pointer-events: none;">
            </div>
        }
    </div>
</div>

<div @ref="_logGridContainer">
<MudDataGrid T="LogRecordModel"
             Items="@_logs"
             Loading="@_dataLoading"
             Height="calc(100vh - 28rem);"
             FixedHeader="true"
             Dense="true"
             ColumnResizeMode="ResizeMode.Column"
             Class="compact-logs-grid"
             RowStyleFunc='@((item, index) => $"background-color: {GetSeverityLightColor(item.SeverityText)};")'>
    <Columns>
        <HierarchyColumn T="LogRecordModel" HeaderClass="mud-theme-secondary" />
        <TemplateColumn Title="Timestamp" HeaderClass="mud-theme-secondary">
            <CellTemplate>
                @if (context.Item.TimeUnixNano.HasValue)
                {
                    @FormatUnixNanoToDateTime(context.Item.TimeUnixNano.Value)
                }
            </CellTemplate>
        </TemplateColumn>
            <TemplateColumn Title="Service" HeaderClass="mud-theme-secondary">
                <CellTemplate>
                    @context.Item.Resource?.Attributes["service.name"]
                </CellTemplate>
            </TemplateColumn>
        <TemplateColumn Title="Level" HeaderClass="mud-theme-secondary"
                        CellStyleFunc='@(item => GetLevelCellStyle(item.SeverityText))'>
            <CellTemplate>
                <span style="font-weight: 600;">@context.Item.SeverityText</span>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.BodyValue" Title="Message" Sortable="false" HeaderClass="mud-theme-secondary"/>
    </Columns>
    <ChildRowContent>
        <MudCard Elevation="0">
            <MudCardContent Style="@($"background-color: color-mix(in srgb, #808080 8%, var(--mud-palette-surface)); border-left: 3px solid {GetSeverityColor(context.Item.SeverityText)}; padding: 16px;")">
                
                <!-- Log Context Section -->
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">
                    Log Context
                </MudText>
                <div style="display: flex; gap: 40px; margin-bottom: 16px;">
                    <MudStack Spacing="1">
                        @if (!string.IsNullOrEmpty(context.Item.TraceIdHex))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); display: inline;">Trace ID:</MudText>
                                <MudLink Href="@($"/traces?traceId={context.Item.TraceIdHex}")" 
                                         Typo="Typo.body2" 
                                         Style="font-family: monospace; font-size: 0.85rem; margin-left: 8px;">
                                    @context.Item.TraceIdHex
                                </MudLink>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(context.Item.SpanIdHex))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); display: inline;">Span ID:</MudText>
                                <MudText Typo="Typo.body2" Style="font-family: monospace; font-size: 0.85rem; display: inline; margin-left: 8px;">
                                    @context.Item.SpanIdHex
                                </MudText>
                            </div>
                        }
                        @if (context.Item.TimeUnixNano.HasValue)
                        {
                            <div>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); display: inline;">Timestamp:</MudText>
                                <MudText Typo="Typo.body2" Style="font-family: monospace; display: inline; margin-left: 8px;">
                                    @FormatUnixNanoToDateTime(context.Item.TimeUnixNano.Value)
                                </MudText>
                            </div>
                        }
                    </MudStack>
                    
                    @if (context.Item.InstrumentationScope != null)
                    {
                        <MudStack Spacing="1">
                            <div>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); display: inline;">Service:</MudText>
                                <MudText Typo="Typo.body2" Style="display: inline; margin-left: 8px;">
                                    @context.Item.Resource?.Attributes["service.name"]
                                </MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); display: inline;">Scope:</MudText>
                                <MudText Typo="Typo.body2" Style="display: inline; margin-left: 8px;">
                                    @context.Item.InstrumentationScope.Name
                                </MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(context.Item.InstrumentationScope.Version))
                            {
                                <div>
                                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); display: inline;">Version:</MudText>
                                    <MudText Typo="Typo.body2" Style="display: inline; margin-left: 8px;">
                                        @context.Item.InstrumentationScope.Version
                                    </MudText>
                                </div>
                            }
                        </MudStack>
                    }
                </div>

                <!-- Log Attributes Section -->
                @if (context.Item.Attributes != null && context.Item.Attributes.Any())
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">
                        Attributes
                    </MudText>
                    <MudSimpleTable Dense="true" Style="font-size: 0.85rem; background-color: var(--mud-palette-surface);">
                        <tbody>
                            @foreach (var attr in context.Item.Attributes.OrderBy(a => a.Key))
                            {
                                <tr>
                                    <td style="font-family: monospace; color: var(--mud-palette-text-secondary); font-weight: 500; padding: 6px 12px;">
                                        @attr.Key
                                    </td>
                                    <td style="padding: 6px 12px;">
                                        @FormatAttributeValue(attr.Value)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

            </MudCardContent>
        </MudCard>
    </ChildRowContent>
    <PagerContent>
        <MudDataGridPager T="LogRecordModel"
                          PageSizeOptions="new int[] { 100, 250, 500, 1000 }"/>
    </PagerContent>
</MudDataGrid>
</div>

<style>
    /* Severity row background colors — automatically adapt via color-mix with --mud-palette-surface */
    :root {
        --severity-trace-bg:   color-mix(in srgb, #9C27B0 12%, var(--mud-palette-surface));
        --severity-debug-bg:   color-mix(in srgb, #2196F3 12%, var(--mud-palette-surface));
        --severity-info-bg:    transparent;
        --severity-warning-bg: color-mix(in srgb, #FF9800 12%, var(--mud-palette-surface));
        --severity-error-bg:   color-mix(in srgb, #f44336 12%, var(--mud-palette-surface));
        --severity-fatal-bg:   color-mix(in srgb, #FF5722 18%, var(--mud-palette-surface));
    }

    /* CRITICAL FIX: Force fixed table layout ONLY on the main data grid, not child tables */
    .compact-logs-grid > .mud-table-container > .mud-table-root {
        table-layout: auto !important;
        min-width: 100% !important;
    }

    .compact-logs-grid {
        container-type: inline-size;
    }

    .compact-logs-grid > .mud-table-container {
        overflow-x: auto !important;
    }
    
    /* Set explicit widths for main grid columns */
    .compact-logs-grid > .mud-table-container > .mud-table-root > thead > tr > th:nth-child(1) {
        width: 50px !important; /* Hierarchy expand/collapse button */
    }
    
    .compact-logs-grid > .mud-table-container > .mud-table-root > thead > tr > th:nth-child(2) {
        width: 200px !important; /* Timestamp */
    }
    
    .compact-logs-grid > .mud-table-container > .mud-table-root > thead > tr > th:nth-child(3) {
        width: 150px !important; /* Service */
    }

    .compact-logs-grid > .mud-table-container > .mud-table-root > thead > tr > th:nth-child(4) {
        width: 130px !important; /* Level */
    }

    .compact-logs-grid > .mud-table-container > .mud-table-root > thead > tr > th:nth-child(5) {
        width: 400px !important; /* Message - minimum, grows with content */
    }
    
    /* Apply monospace font to main grid body cells (descendant selectors survive Virtualize wrappers) */
    .compact-logs-grid .mud-table-body .mud-table-row:not(.mud-table-row-group-footer) .mud-table-cell {
        font-family: 'Consolas', 'Courier New', Courier, monospace !important;
        font-size: 0.78rem !important;
        white-space: nowrap !important;
    }

    /* Belt-and-suspenders: also target spans inside PropertyColumn cells */
    .compact-logs-grid .mud-table-body .mud-table-row:not(.mud-table-row-group-footer) .mud-table-cell span {
        font-family: 'Consolas', 'Courier New', Courier, monospace !important;
        font-size: 0.78rem !important;
    }

    /* Reduce cell padding to make rows more compact */
    .mud-table-cell {
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        line-height: 1.2 !important;
    }
    
    /* Ensure expanded child content row displays properly */
    .compact-logs-grid .mud-table-row-group-footer td {
        padding: 8px !important;
        overflow: hidden !important;
    }

    /* Constrain child content card to visible container width, not table width */
    .compact-logs-grid .mud-table-row-group-footer .mud-card {
        max-width: 100cqi !important;
        width: 100cqi !important;
        box-sizing: border-box !important;
    }

    /* Table expands to content; wrapper scrolls */
    .compact-logs-grid .mud-simple-table table {
        table-layout: auto !important;
        min-width: 100% !important;
    }

    /* Key column: Let it size based on content, prevent wrapping */
    .compact-logs-grid .mud-simple-table td:first-child {
        width: 1% !important; /* Trick: makes it as narrow as possible while fitting content */
        white-space: nowrap !important; /* Prevent wrapping */
        font-family: monospace !important;
        color: var(--mud-palette-text-secondary) !important;
        font-weight: 500 !important;
        padding: 6px 12px !important;
    }

    /* Value column: don't wrap — let the scrollbar handle it */
    .compact-logs-grid .mud-simple-table td:last-child {
        width: 99% !important;
        white-space: pre !important;
        font-family: Consolas, 'Courier New', monospace !important;
        font-size: 0.85rem !important;
        padding: 6px 12px !important;
    }

    /* Prevent attribute tables from expanding card width */
    .compact-logs-grid .mud-simple-table {
        max-width: 100% !important;
        overflow-x: auto !important;
    }

    /* Constrain the entire card content to prevent horizontal expansion */
    .compact-logs-grid .mud-card-content {
        max-width: 100% !important;
        overflow-x: auto !important;
    }

    /* Remove default grid spacing that might push content */
    .compact-logs-grid .mud-grid {
        margin: 0 !important;
    }

    /* Ensure MudItems don't have extra padding */
    .compact-logs-grid .mud-grid .mud-grid-item {
        padding: 0 !important;
    }
</style>
