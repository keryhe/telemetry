@page "/traces/{TraceId}"
@using Keryhe.Telemetry.Core.Models
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<PageTitle>Trace @TruncateTraceId(TraceId)</PageTitle>

<SectionContent SectionName="page-title">
    <MudText Typo="Typo.h6" Style="font-weight: 600;">Trace Detail</MudText>
</SectionContent>

<style>
    .trace-scale {
        display: flex;
        border-bottom: 2px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
    }
    .trace-scale-info {
        width: 40%;
        min-width: 260px;
        padding: 6px 12px;
        border-right: 1px solid var(--mud-palette-divider);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
    }
    .trace-scale-ticks {
        flex: 1;
        position: relative;
        height: 28px;
    }
    .trace-scale-tick {
        position: absolute;
        transform: translateX(-50%);
        font-size: 0.7rem;
        color: var(--mud-palette-text-secondary);
        top: 6px;
        white-space: nowrap;
    }
    .trace-scale-tick::before {
        content: '';
        position: absolute;
        top: -6px;
        left: 50%;
        height: 4px;
        width: 1px;
        background: var(--mud-palette-text-secondary);
    }
    .trace-row {
        display: flex;
        border-bottom: 1px solid var(--mud-palette-divider);
        min-height: 34px;
        cursor: pointer;
        transition: background 0.1s;
    }
    .trace-row:hover {
        background: var(--mud-palette-action-default-hover);
    }
    .trace-row.trace-row-selected {
        background: var(--mud-palette-primary-hover);
    }
    .trace-row.trace-row-error {
        background: rgba(244, 67, 54, 0.04);
    }
    .trace-col-info {
        width: 40%;
        min-width: 260px;
        display: flex;
        align-items: stretch;
        overflow: hidden;
        border-right: 1px solid var(--mud-palette-divider);
    }
    .trace-svc-bar {
        width: 4px;
        flex-shrink: 0;
    }
    .trace-col-info-content {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        overflow: hidden;
        flex: 1;
    }
    .trace-chevron {
        cursor: pointer;
        user-select: none;
        font-size: 0.7rem;
        flex-shrink: 0;
        width: 14px;
        color: var(--mud-palette-text-secondary);
    }
    .trace-chevron-spacer {
        width: 14px;
        flex-shrink: 0;
    }
    .trace-svc-name {
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
        flex-shrink: 0;
        color: var(--mud-palette-text-primary);
    }
    .trace-op-name {
        font-size: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--mud-palette-text-primary);
    }
    .trace-col-bars {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
    }
    .trace-tick {
        position: absolute;
        top: 0;
        bottom: 0;
        border-left: 1px dashed var(--mud-palette-divider);
    }
    .trace-bar {
        position: absolute;
        height: 18px;
        border-radius: 3px;
        display: flex;
        align-items: center;
        overflow: hidden;
        min-width: 2px;
    }
    .trace-bar-error {
        outline: 2px solid #F44336;
        outline-offset: 1px;
    }
    .trace-bar-label {
        font-size: 0.68rem;
        color: white;
        padding: 0 5px;
        white-space: nowrap;
        overflow: hidden;
        font-weight: 500;
    }
    .trace-detail {
        background: var(--mud-palette-surface);
        border-bottom: 2px solid var(--mud-palette-divider);
        border-top: 1px solid var(--mud-palette-divider);
        padding: 16px 20px;
    }
</style>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_errorMessage != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <!-- Header -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.h6">Trace: @TruncateTraceId(TraceId, 32)</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">@TraceId</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small"
                                       Color="Color.Secondary"
                                       OnClick="@(() => CopyToClipboard(TraceId))"
                                       title="Copy Trace ID"/>
                    </MudStack>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Description"
                               Href="@($"/logs?traceId={TraceId}")">
                        View Logs
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo("/traces"))">
                        Back to List
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <!-- Summary -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Duration</MudText>
                    <MudText Typo="Typo.h6">@FormatRelativeNano(_traceDurationNano)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Spans</MudText>
                    <MudText Typo="Typo.h6">@_selectedTraceSpans.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Services</MudText>
                    <MudText Typo="Typo.h6">@_serviceColorMap.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="1" Class="pa-3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Status</MudText>
                    @if (_selectedTraceSpans.Any(s => s.StatusCode == SpanStatusCode.ERROR))
                    {
                        <MudText Typo="Typo.h6" Color="Color.Error">ERROR</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.h6" Color="Color.Success">OK</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Waterfall -->
        <MudPaper Elevation="2" Style="overflow: hidden;">

            <!-- Time scale header -->
            <div class="trace-scale">
                <div class="trace-scale-info">Service / Operation</div>
                <div class="trace-scale-ticks">
                    @for (var i = 0; i <= 4; i++)
                    {
                        var pct = i * 25;
                        var label = FormatRelativeNano((long)(_traceDurationNano * pct / 100.0));
                        <span class="trace-scale-tick" style="left: @(pct)%;">@label</span>
                    }
                </div>
            </div>

            <!-- Span rows -->
            @foreach (var row in GetVisibleRows())
            {
                var span = row.Span;
                var svc = GetServiceName(span);
                var color = _serviceColorMap.GetValueOrDefault(svc, "var(--mud-palette-primary)");
                var leftPct = GetSpanLeftPct(span).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                var widthPct = GetSpanWidthPct(span);
                var widthPctStr = widthPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                var spanDurationNano = span.EndTimeUnixNano - span.StartTimeUnixNano;
                var isError = span.StatusCode == SpanStatusCode.ERROR;
                var isSelected = _selectedSpanId == span.SpanIdHex;
                var isCollapsed = _collapsedSpanIds.Contains(span.SpanIdHex);
                var spanId = span.SpanIdHex;

                <div class="trace-row @(isError ? "trace-row-error" : "") @(isSelected ? "trace-row-selected" : "")"
                     @onclick="() => ToggleSpanDetail(spanId)">

                    <!-- Left: service / operation -->
                    <div class="trace-col-info">
                        <div class="trace-svc-bar" style="background: @color;"></div>
                        <div class="trace-col-info-content" style="padding-left: @(row.Depth * 20 + 8)px;">
                            @if (row.HasChildren)
                            {
                                <span class="trace-chevron"
                                      @onclick:stopPropagation="true"
                                      @onclick="() => ToggleCollapse(spanId)">
                                    @(isCollapsed ? "▶" : "▼")
                                </span>
                            }
                            else
                            {
                                <span class="trace-chevron-spacer"></span>
                            }
                            <span class="trace-svc-name">@svc</span>
                            <span class="trace-op-name">@span.Name</span>
                        </div>
                    </div>

                    <!-- Right: bar -->
                    <div class="trace-col-bars">
                        <div class="trace-tick" style="left: 25%;"></div>
                        <div class="trace-tick" style="left: 50%;"></div>
                        <div class="trace-tick" style="left: 75%;"></div>
                        <div class="trace-bar @(isError ? "trace-bar-error" : "")"
                             style="left: @(leftPct)%; width: @(widthPctStr)%; background: @color; opacity: 0.85;">
                            @if (widthPct > 8)
                            {
                                <span class="trace-bar-label">@FormatRelativeNano(spanDurationNano)</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Inline detail panel -->
                @if (isSelected)
                {
                    <div class="trace-detail">
                        <MudGrid Spacing="3">

                            <!-- Identity -->
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Identity</MudText>
                                <MudSimpleTable Dense="true" Style="font-size: 0.8rem;">
                                    <tbody>
                                        <tr>
                                            <td><strong>Span ID</strong></td>
                                            <td style="font-family: monospace;">@span.SpanIdHex</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Name</strong></td>
                                            <td style="font-family: monospace;">@span.Name</td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(span.ParentSpanIdHex))
                                        {
                                            <tr>
                                                <td><strong>Parent Span</strong></td>
                                                <td style="font-family: monospace;">@span.ParentSpanIdHex</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td><strong>Service</strong></td>
                                            <td>@svc</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Kind</strong></td>
                                            <td>@span.Kind</td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(span.TraceState))
                                        {
                                            <tr>
                                                <td><strong>Trace State</strong></td>
                                                <td style="font-family: monospace;">@span.TraceState</td>
                                            </tr>
                                        }
                                        @if (span.InstrumentationScope != null)
                                        {
                                            <tr>
                                                <td><strong>Library</strong></td>
                                                <td>@span.InstrumentationScope.Name @(span.InstrumentationScope.Version != null ? $"v{span.InstrumentationScope.Version}" : "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </MudItem>

                            <!-- Timing & Status -->
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Timing &amp; Status</MudText>
                                <MudSimpleTable Dense="true" Style="font-size: 0.8rem;">
                                    <tbody>
                                        <tr>
                                            <td><strong>Start</strong></td>
                                            <td>@FormatDateTime(UnixNanoToDateTime(span.StartTimeUnixNano))</td>
                                        </tr>
                                        <tr>
                                            <td><strong>End</strong></td>
                                            <td>@FormatDateTime(UnixNanoToDateTime(span.EndTimeUnixNano))</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Duration</strong></td>
                                            <td>@FormatRelativeNano(span.EndTimeUnixNano - span.StartTimeUnixNano)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status</strong></td>
                                            <td>
                                                <MudChip Size="Size.Small"
                                                         Color="@(span.StatusCode == SpanStatusCode.ERROR ? Color.Error : Color.Success)"
                                                         Variant="Variant.Filled"
                                                         T="string">
                                                    @span.StatusCode
                                                </MudChip>
                                                @if (!string.IsNullOrEmpty(span.StatusMessage))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-2">@span.StatusMessage</MudText>
                                                }
                                            </td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudItem>

                            <!-- Attributes -->
                            @if (span.Attributes?.Any() == true)
                            {
                                <MudItem xs="12">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                                        <MudText Typo="Typo.subtitle2">Attributes (@span.Attributes.Count)</MudText>
                                        @if (span.DroppedAttributesCount > 0)
                                        {
                                            <MudTooltip Text="@($"{span.DroppedAttributesCount} attribute(s) dropped due to limits")">
                                                <MudChip Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" T="string">
                                                    ⚠ @span.DroppedAttributesCount dropped
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                    <MudSimpleTable Dense="true" Style="font-size: 0.8rem;">
                                        <thead>
                                            <tr>
                                                <th style="width: 35%;">Key</th>
                                                <th>Value</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var attr in span.Attributes.OrderBy(a => a.Key))
                                            {
                                                <tr>
                                                    <td style="font-family: monospace; color: var(--mud-palette-text-secondary);">@attr.Key</td>
                                                    <td style="font-family: monospace; word-break: break-all;">@FormatAttributeValue(attr.Value)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                </MudItem>
                            }

                            <!-- Events -->
                            @if (span.Events?.Any() == true)
                            {
                                <MudItem xs="12">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                                        <MudText Typo="Typo.subtitle2">Events (@span.Events.Count)</MudText>
                                        @if (span.DroppedEventsCount > 0)
                                        {
                                            <MudTooltip Text="@($"{span.DroppedEventsCount} event(s) dropped due to limits")">
                                                <MudChip Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" T="string">
                                                    ⚠ @span.DroppedEventsCount dropped
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                    @foreach (var evt in span.Events.OrderBy(e => e.TimeUnixNano))
                                    {
                                        var evtTime = UnixNanoToDateTime(evt.TimeUnixNano).ToLocalTime();
                                        <div style="padding: 6px 0; border-bottom: 1px solid var(--mud-palette-divider);">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Color="Color.Info"/>
                                                <MudText Typo="Typo.body2">@evt.Name</MudText>
                                                <MudText Typo="Typo.caption" Style="font-family: monospace; color: var(--mud-palette-text-secondary);">@evtTime.ToString("HH:mm:ss.fff")</MudText>
                                            </MudStack>
                                            @if (evt.Attributes?.Any() == true)
                                            {
                                                <MudText Typo="Typo.caption" Class="ml-6" Style="color: var(--mud-palette-text-secondary);">
                                                    @string.Join(", ", evt.Attributes.Select(a => $"{a.Key}={FormatAttributeValue(a.Value)}"))
                                                </MudText>
                                            }
                                        </div>
                                    }
                                </MudItem>
                            }

                            <!-- Links -->
                            @if (span.Links?.Any() == true)
                            {
                                <MudItem xs="12">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                                        <MudText Typo="Typo.subtitle2">Links (@span.Links.Count)</MudText>
                                        @if (span.DroppedLinksCount > 0)
                                        {
                                            <MudTooltip Text="@($"{span.DroppedLinksCount} link(s) dropped due to limits")">
                                                <MudChip Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" T="string">
                                                    ⚠ @span.DroppedLinksCount dropped
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                    @foreach (var link in span.Links)
                                    {
                                        <div style="padding: 6px 0; border-bottom: 1px solid var(--mud-palette-divider);">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Color="Color.Secondary"/>
                                                <MudText Typo="Typo.body2" Style="font-family: monospace; font-size: 0.8rem;">@link.LinkedTraceIdHex</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Span: @link.LinkedSpanIdHex</MudText>
                                            </MudStack>
                                        </div>
                                    }
                                </MudItem>
                            }

                        </MudGrid>
                    </div>
                }
            }
        </MudPaper>
    </MudStack>
}

