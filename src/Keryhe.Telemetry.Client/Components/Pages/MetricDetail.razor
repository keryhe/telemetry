@page "/metrics/detail/{MetricName}"
@using Keryhe.Telemetry.Core.Models
@using Keryhe.Telemetry.Client.Models
@using Keryhe.Telemetry.Client.Components.Shared

<PageTitle>Metric: @MetricName</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <!-- Breadcrumbs -->
    <MudBreadcrumbs Items="_breadcrumbItems" Class="mb-4"/>

    @if (_loading && _metricData == null)
    {
        <MudPaper Class="pa-4 d-flex align-center justify-center" Style="height: 400px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
        </MudPaper>
    }
    else if (_metricData == null)
    {
        <MudAlert Severity="Severity.Warning">
            Metric "@MetricName" not found or has no data.
        </MudAlert>
    }
    else
    {
        <!-- Header Section -->
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudText Typo="Typo.h5">@MetricName</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GetMetricTypeColor(_metricData.Type)" Variant="Variant.Filled">
                            @_metricData.Type
                        </MudChip>
                    </MudStack>
                    <MudStack Spacing="1">
                        @if (!string.IsNullOrEmpty(_serviceName))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                <strong>Service:</strong> @_serviceName
                            </MudText>
                        }
                        @if (!string.IsNullOrEmpty(_metricInfo?.Unit))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                <strong>Unit:</strong> @_metricInfo.Unit
                            </MudText>
                        }
                        @if (!string.IsNullOrEmpty(_metricInfo?.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                <strong>Description:</strong> @_metricInfo.Description
                            </MudText>
                        }
                    </MudStack>
                </div>
                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="RefreshDataAsync"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               Disabled="@_loading">
                        Refresh
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="ExportDataAsync"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@(_metricData.Points == null || !_metricData.Points.Any())">
                        Export CSV
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <!-- Stats Cards -->
        @if (_canShowStats)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Current Value</MudText>
                                <MudText Typo="Typo.h5">@FormatValue(_currentValue)</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Minimum</MudText>
                                <MudText Typo="Typo.h5">@FormatValue(_minValue)</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Maximum</MudText>
                                <MudText Typo="Typo.h5">@FormatValue(_maxValue)</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Average</MudText>
                                <MudText Typo="Typo.h5">@FormatValue(_avgValue)</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }

        <!-- Time Range Selector and Auto-Refresh -->
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudSelect @bind-Value="_selectedTimeRange"
                           Label="Time Range"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           T="TimeRange"
                           Style="min-width: 200px;">
                    @foreach (TimeRange range in Enum.GetValues(typeof(TimeRange)))
                    {
                        if (range != TimeRange.Custom)
                        {
                            <MudSelectItem Value="@range">@range.GetDisplayName()</MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudSwitch @bind-Value="_autoRefresh"
                           Color="Color.Primary"
                           Label="Auto-refresh"
                           T="bool"/>

                @if (_autoRefresh)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        (every @_refreshInterval seconds)
                    </MudText>
                }

                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true"/>
                }
            </MudStack>
        </MudPaper>

        <!-- Tabbed Content -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <!-- Chart Tab -->
            <MudTabPanel Text="Chart" Icon="@Icons.Material.Filled.ShowChart">
                <MetricChart Data="@_metricData" Height="400" Title="@MetricName"/>
            </MudTabPanel>

            <!-- Data Points Tab -->
            <MudTabPanel Text="Data Points" Icon="@Icons.Material.Filled.TableChart">
                @if (_metricData.Points != null && _metricData.Points.Any())
                {
                    <MudTable Items="@_metricData.Points" Dense="true" Hover="true" FixedHeader="true" Height="500px">
                        <HeaderContent>
                            <MudTh>Timestamp</MudTh>
                            <MudTh>Value</MudTh>
                            <MudTh>Attributes</MudTh>
                            @if (_metricData.Type == MetricType.HISTOGRAM)
                            {
                                <MudTh>Count</MudTh>
                                <MudTh>Sum</MudTh>
                                <MudTh>Min</MudTh>
                                <MudTh>Max</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Timestamp">@context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                            <MudTd DataLabel="Value">@((context.DoubleValue ?? context.IntValue)?.ToString("F2") ?? "N/A")</MudTd>
                            <MudTd DataLabel="Attributes">
                                @if (context.Attributes != null && context.Attributes.Any())
                                {
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var attr in context.Attributes)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                <strong>@attr.Key</strong>: @FormatAttributeValue(attr.Value)
                                            </MudChip>
                                        }
                                    </MudStack>
                                }
                            </MudTd>
                            @if (_metricData.Type == MetricType.HISTOGRAM)
                            {
                                <MudTd DataLabel="Count">@context.Count</MudTd>
                                <MudTd DataLabel="Sum">@context.Sum?.ToString("F2")</MudTd>
                                <MudTd DataLabel="Min">@context.Min?.ToString("F2")</MudTd>
                                <MudTd DataLabel="Max">@context.Max?.ToString("F2")</MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary">No data points available</MudText>
                }
            </MudTabPanel>

            <!-- Metadata Tab -->
            <MudTabPanel Text="Metadata" Icon="@Icons.Material.Filled.Info">
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr>
                            <td><strong>Metric Name</strong></td>
                            <td>@MetricName</td>
                        </tr>
                        <tr>
                            <td><strong>Type</strong></td>
                            <td><MudChip T="string" Size="Size.Small" Color="@GetMetricTypeColor(_metricData.Type)">@_metricData.Type</MudChip></td>
                        </tr>
                        @if (!string.IsNullOrEmpty(_metricInfo?.Unit))
                        {
                            <tr>
                                <td><strong>Unit</strong></td>
                                <td>@_metricInfo.Unit</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_metricInfo?.Description))
                        {
                            <tr>
                                <td><strong>Description</strong></td>
                                <td>@_metricInfo.Description</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_serviceName))
                        {
                            <tr>
                                <td><strong>Service</strong></td>
                                <td>@_serviceName</td>
                            </tr>
                        }
                        @if (_metricInfo != null)
                        {
                            <tr>
                                <td><strong>First Seen</strong></td>
                                <td>@_metricInfo.FirstSeen.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                            <tr>
                                <td><strong>Last Seen</strong></td>
                                <td>@_metricInfo.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                            <tr>
                                <td><strong>Data Point Count</strong></td>
                                <td>@_metricInfo.DataPointCount</td>
                            </tr>
                        }
                        <tr>
                            <td><strong>Current Data Points</strong></td>
                            <td>@(_metricData.Points?.Count ?? 0)</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudTabPanel>

            <!-- Labels Tab -->
            <MudTabPanel Text="Labels" Icon="@Icons.Material.Filled.Label">
                @if (_labels != null && _labels.Any())
                {
                    <MudStack Spacing="3">
                        @foreach (var label in _labels)
                        {
                            <MudPaper Class="pa-3" Elevation="1">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 500;" Class="mb-2">@label.Key</MudText>
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    @foreach (var value in label.Value)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@value</MudChip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    @label.Value.Count distinct value(s)
                                </MudText>
                            </MudPaper>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary">No labels/attributes available for this metric</MudText>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
}
