@page "/traces"
@using ApexCharts
@using Keryhe.Telemetry.Core.Models
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<PageTitle>Traces</PageTitle>

<SectionContent SectionName="page-title">
    <MudText Typo="Typo.h6" Style="font-weight: 600;">Traces</MudText>
</SectionContent>


<MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <!-- Tab 1: Trace List -->
    <MudTabPanel Text="Trace List" Icon="@Icons.Material.Filled.List">
        <!-- Filter Bar -->
        <MudStack Spacing="2" Class="mb-4">
            <!-- Row 1: Quick Filters, Service, Search Button -->
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2">Filter:</MudText>
                <MudChipSet @bind-SelectedValue="_filterMode" T="string">
                    <MudChip Text="All Traces" Value="@("all")" OnClick="@(() => OnFilterModeChanged("all"))" Default="true"/>
                    <MudChip Text="Errors Only" Value="@("errors")" Color="Color.Error" OnClick="@(() => OnFilterModeChanged("errors"))"/>
                    <MudChip Text="Slow Traces" Value="@("slow")" Color="Color.Warning" OnClick="@(() => OnFilterModeChanged("slow"))"/>
                </MudChipSet>

                @if (_filterMode == "slow")
                {
                    <MudNumericField @bind-Value="_minDurationMs"
                                     Label="Min Duration (ms)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="1"
                                     Style="width: 200px;"/>
                }

                <MudSelect @bind-Value="_selectedService"
                           Label="Service"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Style="width: 250px;"
                           T="string">
                    @foreach (var service in _availableServices)
                    {
                        <MudSelectItem Value="@service">@service</MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SearchTraces"
                           StartIcon="@Icons.Material.Filled.Search">
                    Search
                </MudButton>
            </MudStack>

            <!-- Row 2: Search Text Field -->
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_searchText"
                              Placeholder='Search: Trace ID OR "operation name" OR key=value OR key:value'
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="Examples: abc123... (Trace ID) | database query | http.status_code=500"
                              Style="flex: 1;"/>
                @if (IsTraceIdSearch)
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="Color.Info"
                             Icon="@Icons.Material.Filled.Link"
                             Text="Trace ID Search"
                             Style="margin-bottom: 20px;"/>
                }
                <MudIconButton Icon="@Icons.Material.Filled.HelpOutline"
                               Color="Color.Info"
                               Size="Size.Small"
                               OnClick="@(() => _showSearchHelp = true)"
                               Style="margin-top: 4px;"/>
            </MudStack>
        </MudStack>

        <!-- Search Help Dialog -->
        <MudDialog @bind-Visible="_showSearchHelp" Options="new DialogOptions { MaxWidth = MaxWidth.Medium }">
            <TitleContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Help" Class="mr-2"/> Search Syntax Guide
                </MudText>
            </TitleContent>
            <DialogContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Search Types</MudText>
                <MudSimpleTable Dense="true" Style="margin-bottom: 16px;">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Example</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Trace ID</strong></td>
                            <td><code>abc123def456...</code></td>
                            <td>Exact trace ID (32 hex chars, date range not required)</td>
                        </tr>
                        <tr>
                            <td><strong>Free Text</strong></td>
                            <td><code>database query</code></td>
                            <td>Searches root operation name and service names</td>
                        </tr>
                        <tr>
                            <td><strong>Exact Attribute</strong></td>
                            <td><code>http.status_code=500</code></td>
                            <td>Root span attribute exact match</td>
                        </tr>
                        <tr>
                            <td><strong>Contains Attribute</strong></td>
                            <td><code>http.url:/api/orders</code></td>
                            <td>Root span attribute contains match</td>
                        </tr>
                        <tr>
                            <td><strong>AND Logic</strong></td>
                            <td><code>GET AND http.status_code=200</code></td>
                            <td>Combine multiple conditions (all must match)</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _showSearchHelp = false)">Close</MudButton>
            </DialogActions>
        </MudDialog>

        <!-- Stats Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Traces</MudText>
                                <MudText Typo="Typo.h5">@_totalTraces</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Large" Color="Color.Primary"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Avg Duration</MudText>
                                <MudText Typo="Typo.h5">@($"{_avgDuration:F0}ms")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Large" Color="Color.Info"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Error Rate</MudText>
                                <MudText Typo="Typo.h5">@($"{_errorRate:F1}%")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Services</MudText>
                                <MudText Typo="Typo.h5">@_servicesCount</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Large" Color="Color.Info"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Timeline Chart -->
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Trace Volume</MudText>
            @if (_hasTraceData)
            {
                <ApexChart @key="@_traceChartRenderKey" TItem="DataPoint" Options="@_chartOptions" Height="150" OnZoomed="HandleChartZoomed">
                    <ApexPointSeries TItem="DataPoint"
                                     Items="@_traceTotal"
                                     Name="Total"
                                     SeriesType="SeriesType.Line"
                                     XValue="@(e => e.Time)"
                                     YValue="@(e => (decimal)e.Value)" />
                    <ApexPointSeries TItem="DataPoint"
                                     Items="@_traceErrors"
                                     Name="Errors"
                                     SeriesType="SeriesType.Line"
                                     XValue="@(e => e.Time)"
                                     YValue="@(e => (decimal)e.Value)" />
                </ApexChart>
            }
            else
            {
                <MudText Color="Color.Secondary" Class="pa-4">No trace data in this window.</MudText>
            }
        </MudPaper>

        <!-- Trace Data Grid -->
        <MudDataGrid T="TraceInfo"
                     Items="@_traces"
                     Loading="@_dataLoading"
                     Height="calc(100vh - 41rem)"
                     FixedHeader="true"
                     Virtualize="true"
                     Dense="true"
                     Hover="true"
                     ColumnResizeMode="ResizeMode.Column">
            <Columns>
                <HierarchyColumn T="TraceInfo"/>
                <TemplateColumn Title="Operation">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">
                            @(context.Item.RootOperationName ?? context.Item.TraceIdHex)
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Service">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                            @(context.Item.ServiceName ?? "unknown")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Duration">
                    <CellTemplate>
                        <MudChip Size="Size.Small"
                                 Style="@($"background-color: {GetDurationColor(context.Item.TraceDuration.TotalMilliseconds)}; color: white;")"
                                 Variant="Variant.Filled">
                            @FormatDuration(context.Item.TraceDuration)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.SpanCount" Title="Spans"/>
                <TemplateColumn Title="Start Time">
                    <CellTemplate>
                        @FormatDateTime(context.Item.TraceStartTime)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudIcon Icon="@GetStatusIcon(context.Item.HasErrors)"
                                 Color="@(context.Item.HasErrors ? Color.Error : Color.Success)"
                                 Size="Size.Small"/>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="@(() => ViewTraceDetails(context.Item.TraceIdHex))">
                            View Details
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudSimpleTable Dense="true" Hover="true" Style="background-color: transparent;">
                            <tbody>
                            <tr>
                                <td><strong>Trace ID:</strong></td>
                                <td style="font-family: monospace;">@context.Item.TraceIdHex</td>
                            </tr>
                            <tr>
                                <td><strong>Duration:</strong></td>
                                <td>@FormatDuration(context.Item.TraceDuration)</td>
                            </tr>
                            <tr>
                                <td><strong>Span Count:</strong></td>
                                <td>@context.Item.SpanCount</td>
                            </tr>
                            <tr>
                                <td><strong>Start Time:</strong></td>
                                <td>@FormatDateTime(context.Item.TraceStartTime)</td>
                            </tr>
                            <tr>
                                <td><strong>End Time:</strong></td>
                                <td>@FormatDateTime(context.Item.TraceEndTime)</td>
                            </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </ChildRowContent>
        </MudDataGrid>
    </MudTabPanel>

    <!-- Tab 2: Service Map -->
    <MudTabPanel Text="Service Map" Icon="@Icons.Material.Filled.AccountTree">
        <MudText Typo="Typo.h6" Class="mb-4">Service Dependencies</MudText>

        @if (_serviceDependencies.Any())
        {
            <ServiceMapGraph Dependencies="_serviceDependencies" />
        }
        else
        {
            <MudAlert Severity="Severity.Info">No service dependencies found for the selected time range.</MudAlert>
        }
    </MudTabPanel>

    <!-- Tab 3: Analytics -->
    <MudTabPanel Text="Analytics" Icon="@Icons.Material.Filled.Analytics">
        <MudStack Spacing="3">
            <MudSelect Value="_selectedAnalyticsService"
                       ValueChanged="OnAnalyticsServiceChanged"
                       Label="Select Service"
                       Variant="Variant.Outlined"
                       T="string"
                       Clearable="true"
                       Style="max-width: 400px;">
                @foreach (var service in _availableServices)
                {
                    <MudSelectItem Value="@service">@service</MudSelectItem>
                }
            </MudSelect>

            @if (!string.IsNullOrEmpty(_selectedAnalyticsService))
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Operation Counts</MudText>
                            @if (_operationCounts.Any())
                            {
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th style="text-align: right;">Count</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var op in _operationCounts.OrderByDescending(x => x.Value).Take(10))
                                    {
                                        <tr>
                                            <td>@op.Key</td>
                                            <td style="text-align: right;">@op.Value.ToString("N0")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No data available</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Average Latencies</MudText>
                            @if (_averageLatencies.Any())
                            {
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th style="text-align: right;">Avg Latency</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var op in _averageLatencies.OrderByDescending(x => x.Value).Take(10))
                                    {
                                        <tr>
                                            <td>@op.Key</td>
                                            <td style="text-align: right;">@($"{op.Value:F2}ms")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No data available</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info">Please select a service to view analytics.</MudAlert>
            }
        </MudStack>
    </MudTabPanel>

</MudTabs>

