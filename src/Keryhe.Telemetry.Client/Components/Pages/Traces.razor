@page "/traces"
@using Keryhe.Telemetry.Core.Models

<PageTitle>Traces</PageTitle>

<MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <!-- Tab 1: Trace List -->
    <MudTabPanel Text="Trace List" Icon="@Icons.Material.Filled.List">
        <!-- Filter Bar -->
        <MudStack Spacing="2" Class="mb-4">
            <MudStack Row="true" Spacing="2">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search by Trace ID or Service..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="flex: 1;"/>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SearchTraces"
                           StartIcon="@Icons.Material.Filled.Search">
                    Search
                </MudButton>
            </MudStack>

            <!-- Quick Filters -->
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2">Filter:</MudText>
                <MudChipSet @bind-SelectedValue="_filterMode" T="string">
                    <MudChip Text="All Traces" Value="@("all")" OnClick="@(() => OnFilterModeChanged("all"))" Default="true"/>
                    <MudChip Text="Errors Only" Value="@("errors")" Color="Color.Error" OnClick="@(() => OnFilterModeChanged("errors"))"/>
                    <MudChip Text="Slow Traces" Value="@("slow")" Color="Color.Warning" OnClick="@(() => OnFilterModeChanged("slow"))"/>
                </MudChipSet>

                @if (_filterMode == "slow")
                {
                    <MudNumericField @bind-Value="_minDurationMs"
                                     Label="Min Duration (ms)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="1"
                                     Style="width: 200px;"/>
                }

                <MudSelect @bind-Value="_selectedService"
                           Label="Service"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Style="width: 250px;"
                           T="string">
                    @foreach (var service in _availableServices)
                    {
                        <MudSelectItem Value="@service">@service</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
        </MudStack>

        <!-- Stats Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Traces</MudText>
                                <MudText Typo="Typo.h5">@_totalTraces</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Large" Color="Color.Primary"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Avg Duration</MudText>
                                <MudText Typo="Typo.h5">@($"{_avgDuration:F0}ms")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Large" Color="Color.Info"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Error Rate</MudText>
                                <MudText Typo="Typo.h5">@($"{_errorRate:F1}%")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Services</MudText>
                                <MudText Typo="Typo.h5">@_servicesCount</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Large" Color="Color.Success"/>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Timeline Chart -->
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Trace Volume</MudText>
            @if (_hasTraceData)
            {
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@_chartSeries"
                          XAxisLabels="@_chartXAxisLabels"
                          Width="100%"
                          Height="150px"
                          LegendPosition="Position.Right"
                          AxisChartOptions="new AxisChartOptions { MatchBoundsToSize = true }"
                          ChartOptions="@_chartOptions"/>
            }
            else
            {
                <MudText Color="Color.Secondary" Class="pa-4">No trace data in this window.</MudText>
            }
        </MudPaper>

        <!-- Trace Data Grid -->
        <MudDataGrid T="TraceInfo"
                     Items="@_traces"
                     Loading="@_dataLoading"
                     Height="calc(100vh - 41rem)"
                     FixedHeader="true"
                     Virtualize="true"
                     Dense="true"
                     Hover="true"
                     ColumnResizeMode="ResizeMode.Column">
            <Columns>
                <HierarchyColumn T="TraceInfo" HeaderClass="mud-theme-secondary"/>
                <TemplateColumn Title="Trace ID" HeaderClass="mud-theme-secondary">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                @TruncateTraceId(context.Item.TraceIdHex)
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           OnClick="@(() => {})"
                                           title="Copy Trace ID"/>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Service" HeaderClass="mud-theme-secondary">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                            @(context.Item.ServiceName ?? "unknown")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Duration" HeaderClass="mud-theme-secondary">
                    <CellTemplate>
                        <MudChip Size="Size.Small"
                                 Style="@($"background-color: {GetDurationColor(context.Item.TraceDuration.TotalMilliseconds)}; color: white;")"
                                 Variant="Variant.Filled">
                            @FormatDuration(context.Item.TraceDuration)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.SpanCount" Title="Spans" HeaderClass="mud-theme-secondary"/>
                <TemplateColumn Title="Start Time" HeaderClass="mud-theme-secondary">
                    <CellTemplate>
                        @FormatDateTime(context.Item.TraceStartTime)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" HeaderClass="mud-theme-secondary">
                    <CellTemplate>
                        <MudIcon Icon="@GetStatusIcon(context.Item.HasErrors)"
                                 Color="@(context.Item.HasErrors ? Color.Error : Color.Success)"
                                 Size="Size.Small"/>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" HeaderClass="mud-theme-secondary">
                    <CellTemplate>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="@(() => ViewTraceDetails(context.Item.TraceIdHex))">
                            View Details
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                <MudCard Elevation="0">
                    <MudCardContent>
                        <MudSimpleTable Dense="true" Hover="true" Style="background-color: transparent;">
                            <tbody>
                            <tr>
                                <td><strong>Trace ID:</strong></td>
                                <td style="font-family: monospace;">@context.Item.TraceIdHex</td>
                            </tr>
                            <tr>
                                <td><strong>Duration:</strong></td>
                                <td>@FormatDuration(context.Item.TraceDuration)</td>
                            </tr>
                            <tr>
                                <td><strong>Span Count:</strong></td>
                                <td>@context.Item.SpanCount</td>
                            </tr>
                            <tr>
                                <td><strong>Start Time:</strong></td>
                                <td>@FormatDateTime(context.Item.TraceStartTime)</td>
                            </tr>
                            <tr>
                                <td><strong>End Time:</strong></td>
                                <td>@FormatDateTime(context.Item.TraceEndTime)</td>
                            </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </ChildRowContent>
        </MudDataGrid>
    </MudTabPanel>

    <!-- Tab 2: Service Map -->
    <MudTabPanel Text="Service Map" Icon="@Icons.Material.Filled.AccountTree">
        <MudText Typo="Typo.h6" Class="mb-4">Service Dependencies</MudText>

        @if (_serviceDependencies.Any())
        {
            <MudDataGrid T="ServiceDependency"
                         Items="@_serviceDependencies"
                         Dense="true"
                         Hover="true"
                         Height="calc(100vh - 20rem)"
                         FixedHeader="true">
                <Columns>
                    <PropertyColumn Property="x => x.ParentService" Title="Parent Service"/>
                    <PropertyColumn Property="x => x.ChildService" Title="Child Service"/>
                    <TemplateColumn Title="Span Kind">
                        <CellTemplate>
                            <MudChip Size="Size.Small"
                                     Style="@($"background-color: {GetSpanKindColor(context.Item.SpanKind)}; color: white;")"
                                     Variant="Variant.Filled">
                                @context.Item.SpanKind
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.CallCount" Title="Calls" Format="N0"/>
                    <PropertyColumn Property="x => x.AvgDurationMs" Title="Avg Duration" Format="F2">
                        <CellTemplate>
                            @($"{context.Item.AvgDurationMs:F2}ms")
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.ErrorCount" Title="Errors" Format="N0"/>
                    <TemplateColumn Title="Error Rate">
                        <CellTemplate>
                            <MudChip Size="Size.Small"
                                     Color="@(context.Item.ErrorRate > 5 ? Color.Error : context.Item.ErrorRate > 1 ? Color.Warning : Color.Success)"
                                     Variant="Variant.Text">
                                @($"{context.Item.ErrorRate:F1}%")
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
        else
        {
            <MudAlert Severity="Severity.Info">No service dependencies found for the selected time range.</MudAlert>
        }
    </MudTabPanel>

    <!-- Tab 3: Analytics -->
    <MudTabPanel Text="Analytics" Icon="@Icons.Material.Filled.Analytics">
        <MudStack Spacing="3">
            <MudSelect Value="_selectedAnalyticsService"
                       ValueChanged="OnAnalyticsServiceChanged"
                       Label="Select Service"
                       Variant="Variant.Outlined"
                       T="string"
                       Clearable="true"
                       Style="max-width: 400px;">
                @foreach (var service in _availableServices)
                {
                    <MudSelectItem Value="@service">@service</MudSelectItem>
                }
            </MudSelect>

            @if (!string.IsNullOrEmpty(_selectedAnalyticsService))
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Operation Counts</MudText>
                            @if (_operationCounts.Any())
                            {
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th style="text-align: right;">Count</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var op in _operationCounts.OrderByDescending(x => x.Value).Take(10))
                                    {
                                        <tr>
                                            <td>@op.Key</td>
                                            <td style="text-align: right;">@op.Value.ToString("N0")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No data available</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Average Latencies</MudText>
                            @if (_averageLatencies.Any())
                            {
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th style="text-align: right;">Avg Latency</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var op in _averageLatencies.OrderByDescending(x => x.Value).Take(10))
                                    {
                                        <tr>
                                            <td>@op.Key</td>
                                            <td style="text-align: right;">@($"{op.Value:F2}ms")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No data available</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info">Please select a service to view analytics.</MudAlert>
            }
        </MudStack>
    </MudTabPanel>

    <!-- Tab 4: Trace Detail -->
    <MudTabPanel Text="Trace Detail" Icon="@Icons.Material.Filled.ZoomIn" Disabled="@(string.IsNullOrEmpty(_selectedTraceId))">
        @if (!string.IsNullOrEmpty(_selectedTraceId))
        {
            <MudStack Spacing="3">
                <!-- Header -->
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.h6">Trace: @TruncateTraceId(_selectedTraceId, 32)</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">@_selectedTraceId</MudText>
                        </div>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Info"
                                       StartIcon="@Icons.Material.Filled.Description"
                                       Href="@($"/logs?traceId={_selectedTraceId}")">
                                View Logs
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ArrowBack"
                                       OnClick="BackToTraceList">
                                Back to List
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                @if (_selectedTraceSpans.Any())
                {
                    var rootSpans = BuildSpanHierarchy();
                    var traceStart = _selectedTraceSpans.Min(s => s.StartTimeUnixNano);
                    var traceEnd = _selectedTraceSpans.Max(s => s.EndTimeUnixNano);
                    var traceDuration = (traceEnd - traceStart) / 1_000_000.0;

                    <!-- Summary Info -->
                    <MudGrid>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-3">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Duration</MudText>
                                <MudText Typo="Typo.h6">@($"{traceDuration:F2}ms")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-3">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Spans</MudText>
                                <MudText Typo="Typo.h6">@_selectedTraceSpans.Count</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-3">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Services</MudText>
                                <MudText Typo="Typo.h6">@_selectedTraceSpans.Select(s => GetServiceName(s)).Distinct().Count()</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-3">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Status</MudText>
                                <MudText Typo="Typo.h6">
                                    @(_selectedTraceSpans.Any(s => s.StatusCode == SpanStatusCode.ERROR) ? "ERROR" : "OK")
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <!-- Span Waterfall -->
                    <MudPaper Elevation="2" Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Span Timeline</MudText>
                        
                        <!-- Header Row -->
                        <MudPaper Elevation="0" Class="mb-2" Style="background-color: #f5f5f5; padding: 12px 4px; border-radius: 4px;">
                            <MudGrid Spacing="0">
                                <MudItem xs="5">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; padding-left: 8px;">Operation</MudText>
                                </MudItem>
                                <MudItem xs="2">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">Start Time</MudText>
                                </MudItem>
                                <MudItem xs="2">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">Duration</MudText>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">Timeline</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                        
                        @foreach (var rootSpan in rootSpans)
                        {
                            @RenderSpanTreeWithTimestamps(rootSpan, 0, traceStart, traceDuration)
                        }
                    </MudPaper>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">Loading trace details...</MudAlert>
                }
            </MudStack>
        }
    </MudTabPanel>
</MudTabs>

