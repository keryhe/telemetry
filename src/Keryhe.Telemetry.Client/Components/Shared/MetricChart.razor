@using Keryhe.Telemetry.Core.Models

@if (_canShowChart && _chartSeries.Any())
{
    <MudChart ChartType="ChartType.Line"
              ChartSeries="@_chartSeries"
              XAxisLabels="@_xAxisLabels"
              Width="100%"
              Height="@($"{Height}px")"
              ChartOptions="@_chartOptions"/>
}
else if (Data?.Type == MetricType.HISTOGRAM || Data?.Type == MetricType.EXPONENTIAL_HISTOGRAM)
{
    <HistogramChart Data="@Data" Height="@Height" />
}
else if (Data?.Type == MetricType.SUMMARY)
{
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Summary metric - showing quantile data:
        </MudText>
        @if (Data?.Points != null && Data.Points.Any() && Data.Points.First().Quantiles != null)
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                <tr>
                    <th>Quantile</th>
                    <th>Value</th>
                </tr>
                </thead>
                <tbody>
                @{
                    var firstPoint = Data.Points.First();
                    if (firstPoint.Quantiles != null && firstPoint.QuantileValues != null)
                    {
                        for (int i = 0; i < firstPoint.Quantiles.Count; i++)
                        {
                            <tr>
                                <td>P@((firstPoint.Quantiles[i] * 100).ToString("F0"))</td>
                                <td>@firstPoint.QuantileValues[i].ToString("F2")</td>
                            </tr>
                        }
                    }
                }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No quantile data available</MudText>
        }
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4 d-flex align-center justify-center" Style="@($"height: {Height}px;")">
        <MudText Typo="Typo.body2" Color="Color.Secondary">No data available for the selected time range</MudText>
    </MudPaper>
}

