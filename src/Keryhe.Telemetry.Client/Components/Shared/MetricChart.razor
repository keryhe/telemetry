@using Keryhe.Telemetry.Core.Models

@if (_canShowChart && _chartSeries.Any())
{
    <MudStack Spacing="3">
        <MudChart ChartType="ChartType.Line"
                  ChartSeries="@_chartSeries"
                  XAxisLabels="@_xAxisLabels"
                  Width="100%"
                  Height="@($"{Height}px")"
                  ChartOptions="@_chartOptions"/>

        @if (Data?.Type == MetricType.HISTOGRAM || Data?.Type == MetricType.EXPONENTIAL_HISTOGRAM)
        {
            <HistogramChart Data="@Data" Height="320" />
        }

        @if (Data?.Type == MetricType.SUMMARY && Data?.Points != null && Data.Points.Any())
        {
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Latest quantile snapshot:
                </MudText>
                @{
                    var latestPoint = Data.Points.OrderByDescending(p => p.Timestamp).FirstOrDefault();
                }
                @if (latestPoint?.Quantiles != null && latestPoint.QuantileValues != null)
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                        <tr>
                            <th>Quantile</th>
                            <th>Value</th>
                        </tr>
                        </thead>
                        <tbody>
                        @for (int i = 0; i < latestPoint.Quantiles.Count && i < latestPoint.QuantileValues.Count; i++)
                        {
                            <tr>
                                <td>P@((latestPoint.Quantiles[i] * 100).ToString("F0"))</td>
                                <td>@latestPoint.QuantileValues[i].ToString("F2")</td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No quantile data available</MudText>
                }
            </MudPaper>
        }
    </MudStack>
}
else
{
    <MudPaper Class="pa-4 d-flex align-center justify-center" Style="@($"height: {Height}px;")">
        <MudText Typo="Typo.body2" Color="Color.Secondary">No data available for the selected time range</MudText>
    </MudPaper>
}

