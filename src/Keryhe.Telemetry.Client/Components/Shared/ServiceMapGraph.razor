@using Keryhe.Telemetry.Core.Models

<div style="position: relative;">
    <div id="cy-service-map" style="width: 100%; height: calc(100vh - 17rem);"></div>

    <MudPaper Elevation="2" Style="position: absolute; bottom: 12px; right: 12px; padding: 10px 14px;">
        <MudStack Spacing="1">
            <MudText Typo="Typo.caption" Style="font-weight: 600;">Legend</MudText>

            <MudText Typo="Typo.caption" Style="font-weight: 500; margin-top: 4px;">Edge Color — Error Rate</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div style="width: 24px; height: 3px; background: #4caf50; border-radius: 2px;"></div>
                <MudText Typo="Typo.caption">≤ 1%</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div style="width: 24px; height: 3px; background: #ff9800; border-radius: 2px;"></div>
                <MudText Typo="Typo.caption">1% – 5%</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div style="width: 24px; height: 3px; background: #f44336; border-radius: 2px;"></div>
                <MudText Typo="Typo.caption">&gt; 5%</MudText>
            </MudStack>

            <MudText Typo="Typo.caption" Style="font-weight: 500; margin-top: 4px;">Edge Thickness — Call Volume</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div style="width: 24px; height: 1px; background: currentColor;"></div>
                <MudText Typo="Typo.caption">Few calls</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div style="width: 24px; height: 5px; background: currentColor; border-radius: 2px;"></div>
                <MudText Typo="Typo.caption">Many calls</MudText>
            </MudStack>

            <MudText Typo="Typo.caption" Style="font-weight: 500; margin-top: 4px;">Edge Label</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.caption" Style="font-family: monospace;">Xms</MudText>
                <MudText Typo="Typo.caption">Avg duration</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
</div>
