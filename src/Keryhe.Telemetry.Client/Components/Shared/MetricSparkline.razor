@using ApexCharts
@using Keryhe.Telemetry.Core.Models
@using Color = MudBlazor.Color

@if (_sparkData.Any())
{
    <ApexChart TItem="SparkPoint" Options="@_chartOptions" Height="@Height">
        <ApexPointSeries TItem="SparkPoint"
                         Items="@_sparkData"
                         Name=""
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Index)"
                         YValue="@(e => (decimal)e.Value)" />
    </ApexChart>
}
else
{
    <div style="@($"height: {Height}px; display: flex; align-items: center; justify-content: center;")">
        <MudText Typo="Typo.caption" Color="Color.Secondary">No data</MudText>
    </div>
}

@code {
}
